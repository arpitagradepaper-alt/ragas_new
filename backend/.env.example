MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
# Hostinger assigns the port itself. Set PORT only if your host does not.
PORT=5000

# SMTP email account used to send password-reset OTPs
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="RAGAS Career World <your-email@gmail.com>"

# Extra allowed browser origins (comma separated), optional.
# localhost dev ports and https://www.ragascareerworld.com are allowed by default.
# Use this for Vercel preview deployments, e.g.:
# CORS_ORIGINS=https://ragas-career-world-git-main-yourteam.vercel.app
CORS_ORIGINS=
